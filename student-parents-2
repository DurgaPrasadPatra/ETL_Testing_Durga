CREATE TABLE students (
    student_id INT PRIMARY KEY,
    first_name VARCHAR(50),
    last_name VARCHAR(50),
    standard_class VARCHAR(20),
    sql_score INT,
    python_score INT,
    etl_score INT,
    monitor_id INT,
    pid INT,
    FOREIGN KEY (pid) REFERENCES parents(pid)
);
