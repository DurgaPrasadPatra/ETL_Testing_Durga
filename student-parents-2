--Get the average SQL score for each class.
select * from students;
select 
standard_class,
avg(sql_score) AS average_score
from students
group by standard_class;

--Count the number of students in each class.
select * from students;

select 
standard_class,
count(student_id) as Total_students
from students
group by standard_class;
--List students and their parents' locations.

select * from students;
select * from parents;
select s.first_name, s.last_name, p.location AS parents_location
from students  s
join parents p
on p.pid=s.pid;

--Retrieve students whose parents are doctors.
select * from students;
select * from parents;

select s.first_name, s.last_name ,p.profession AS parents_profession
from students s
join parents p 
on p.pid=s.pid
where p.profession='Doctor';
--Find students with ETL scores greater than 85 and Python scores greater than 85.
select first_name, last_name , ETL_score,python_score
from students
where ETL_score > 85 and python_score>85;
--Show students whose total score across subjects is greater than 260.
select * from students;
--main query
select student_id ,
		CONCAT(first_name,' ',last_name) AS full_name ,
		Sum_score
	                             
--find total score across subjects is greater than 260
       from	   (
	  			select
				student_id, first_name , last_name,
				sql_score, python_score, etl_Score ,
	            (sql_score+ python_score+ etl_Score ) AS Sum_score
				from students
				where (sql_score+ python_score+ etl_Score ) >260
			  ) t ;

				

--Get the class with the highest average Python score.

SELECT TOP 1 standard_class
FROM (
    SELECT standard_class, AVG(python_score) AS avg_python_score
    FROM students
    GROUP BY standard_class
) AS class_avg
ORDER BY avg_python_score DESC;

--Get the class with the highest average Python score.
SELECT TOP 1 
    standard_class 
FROM students
GROUP BY standard_class
ORDER BY AVG(python_score) DESC;

