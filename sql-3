--Find students who scored above the average SQL score.
--main query
select
*
From
--subquery
		(select 
		student_id,First_name,Sql_score,
		AVG(Sql_score) OVER ()Avg_sql_Score  --to get avg sql score in each row
		from students) t
where sql_score > Avg_sql_Score

  --   (select student_id,first_name,sql_Score ,avg(sql_score)
	--  from students
	--  group by student_id
	 -- having sql_score > (avg(sql_score))
	 -- ) AS t

SELECT student_id, first_name, sql_score
FROM students
WHERE sql_score > 
(    SELECT AVG(sql_score) FROM students);

--Get student names and their average score across SQL, Python, and ETL.ALso Rank them
select 
student_id,
first_name,
ROUND( ((sql_score+python_score+etl_score)/3.0),2) AS AVg_Score,
RANK() OVER (ORDER BY (ROUND( ((sql_score+python_score+etl_score)/3.0),2)) DESC) AS rank_position
from students;
