select s.student_id ,s.first_name,
	   p.location
from students s
join parents p
on s.pid=p.pid
WHERE p.location IN (
    SELECT p2.location
    FROM students s2
    JOIN parents p2 ON s2.pid = p2.pid
    GROUP BY p2.location
    HAVING COUNT(*) > 1
);
--Another Approach
SELECT 
    s.student_id, 
    s.first_name, 
    p.location
FROM students s
JOIN parents p ON s.pid = p.pid
JOIN (
    SELECT p2.location
    FROM students s2
    JOIN parents p2 ON s2.pid = p2.pid
    GROUP BY p2.location
    HAVING COUNT(*) > 1
) AS multiple_loc ON p.location = multiple_loc.location;

